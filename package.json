{
  "name": "ai-workflow-platform",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev-desktop.ps1",
    "dev:renderer": "npm --workspace apps/renderer run dev --",
    "dev:desktop": "npm --workspace apps/desktop run dev",
    "build": "npm --workspace packages/contracts run build && npm --workspace apps/renderer run build && npm --workspace apps/desktop run build",
    "build:runtime:exe": "powershell -ExecutionPolicy Bypass -File scripts/package-runtime.ps1",
    "package:win:full": "powershell -ExecutionPolicy Bypass -File scripts/package-windows-full.ps1",
    "package:win:installer": "npm run build && npm run build:runtime:exe && npm --workspace @workflow-platform/desktop run package:win",
    "test": "npm --workspace packages/contracts run test && npm --workspace apps/renderer run test && npm --workspace apps/desktop run test",
    "test:runtime": "cd runtime && python -m pytest",
    "test:e2e": "playwright test",
    "test:e2e:p1": "playwright test tests/e2e/workflow-p1.spec.ts",
    "test:e2e:packaged": "set PLAYWRIGHT_SKIP_WEB_SERVER=1&& playwright test tests/e2e/desktop-packaged.spec.ts",
    "test:e2e:installed": "set PLAYWRIGHT_SKIP_WEB_SERVER=1&& playwright test tests/e2e/desktop-installed.spec.ts",
    "test:package-script": "powershell -ExecutionPolicy Bypass -File scripts/test-package-windows-full.ps1",
    "verify": "npm run test && npm run test:runtime",
    "verify:ps": "powershell -ExecutionPolicy Bypass -File scripts/verify.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.0.0",
    "7zip-bin": "^5.2.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.0"
  }
}
